rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    match /curations/{curationId} {
      allow read: if true; // Public read — curations are public content
      allow write: if false; // Admin only via Cloud Functions
    }

    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;
    }

    match /plans/{planId} {
      allow read: if isAuthenticated()
        && (resource.data.user_id == request.auth.uid || resource.data.is_public == true);
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && resource.data.user_id == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && resource.data.user_id == request.auth.uid;
    }

    match /phrases/{phraseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /rankings/{rankingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /hosts/{hostUid} {
      // Any authenticated user can read host profiles
      allow read: if isAuthenticated();
      // Only the host themselves can create or update their profile
      allow create, update: if isOwner(hostUid);
      // Hosts cannot be deleted directly (use Cloud Functions for cleanup)
      allow delete: if false;
    }

    match /culture_content/{docId} {
      allow read: if true; // Public content
      allow write: if false;
    }

    match /host_requests/{requestId} {
      // Guest and host can both read their own requests
      allow read: if isAuthenticated()
        && (resource.data.guest_uid == request.auth.uid
            || resource.data.host_uid == request.auth.uid);
      // Guests create requests
      allow create: if isAuthenticated()
        && request.resource.data.guest_uid == request.auth.uid;
      // Only the host can update the status (accept/decline)
      allow update: if isAuthenticated()
        && resource.data.host_uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
