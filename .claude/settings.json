{
  "name": "Japan Explorer",
  "description": "AI-Powered Japan Travel App - Flutter Application",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Glob",
      "Grep",
      "Artifact",
      "Agent",
      "Workflow",
      "SendMessage",
      "mcp__Claude_Code_Remote__*",
      "mcp__github__*",
      "*"
    ]
  },
  "environment": {
    "FLUTTER_VERSION": "3.x",
    "DART_DEFINES": "ENABLE_ANALYTICS=true"
  },
  "recommendations": {
    "skills": [
      {
        "name": "build-and-test",
        "description": "ビルド完了後の自動エミュレータテスト（起動・連携・購入・認証・広告）"
      },
      {
        "name": "security-review",
        "description": "セキュリティレビュー自動実行"
      },
      {
        "name": "code-review",
        "description": "コード品質レビュー"
      }
    ]
  }
}
